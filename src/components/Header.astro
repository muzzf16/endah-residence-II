---
---
<header class="sticky top-0 z-50 w-full bg-white/85 backdrop-blur-md border-b border-neutral-200/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo Brand -->
      <a href="/" class="flex items-center gap-2 group transition">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-emerald-900 to-brand-emerald-600 flex items-center justify-center shadow-md shadow-brand-emerald-900/20 group-hover:scale-105 transition duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-outfit font-extrabold text-lg sm:text-xl tracking-tight leading-none bg-gradient-to-r from-brand-emerald-950 to-brand-emerald-700 bg-clip-text text-transparent">
            ENDAH RESIDENCE II
          </span>
          <span class="text-[10px] font-bold text-brand-amber-600 tracking-widest uppercase">
            Bandar • Batang
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-8 font-outfit font-semibold text-neutral-700 text-sm tracking-wide">
        <a href="/" class="hover:text-brand-emerald-700 transition relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-emerald-600 hover:after:w-full after:transition-all">Beranda</a>
        <a href="/unit" class="hover:text-brand-emerald-700 transition relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-emerald-600 hover:after:w-full after:transition-all">Katalog Unit</a>
        <a href="/galeri-progres" class="hover:text-brand-emerald-700 transition relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-emerald-600 hover:after:w-full after:transition-all">Progres Proyek</a>
        <a href="/tentang-kami" class="hover:text-brand-emerald-700 transition relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-emerald-600 hover:after:w-full after:transition-all">Tentang Kami</a>
        <a href="/kontak" class="hover:text-brand-emerald-700 transition relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-emerald-600 hover:after:w-full after:transition-all">Kontak</a>
      </nav>

      <!-- Desktop Action CTA -->
      <div class="hidden md:block">
        <a 
          href="https://wa.me/6282134994060?text=Halo%20Tim%20Endah%20Residence%20II%2C%20saya%20melihat%20informasi%20dari%20Website.%20Saya%20tertarik%20dengan%20perumahan%20Anda%20dan%20ingin%20menanyakan%20informasi%20unit.%20Mohon%20bantuannya." 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center bg-brand-emerald-800 hover:bg-brand-emerald-700 text-white font-outfit font-bold text-sm px-6 py-3 rounded-xl transition duration-300 shadow-md shadow-brand-emerald-800/10 hover:scale-[1.02] active:scale-[0.98]"
        >
          Hubungi Marketing
        </a>
      </div>

      <!-- Pure CSS Mobile Menu Toggle Hamburger -->
      <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
      
      <label 
        for="mobile-menu-toggle" 
        class="md:hidden flex flex-col justify-between w-6 h-4.5 cursor-pointer z-50 relative group"
        aria-label="Toggle navigation menu"
      >
        <span class="w-full h-0.75 bg-neutral-800 rounded transition-all duration-300 origin-left peer-checked:rotate-45 peer-checked:translate-x-1"></span>
        <span class="w-full h-0.75 bg-neutral-800 rounded transition-all duration-300 peer-checked:opacity-0"></span>
        <span class="w-full h-0.75 bg-neutral-800 rounded transition-all duration-300 origin-left peer-checked:-rotate-45 peer-checked:translate-x-1"></span>
      </label>

      <!-- Mobile Menu Background Overlay Backdrop -->
      <label 
        for="mobile-menu-toggle" 
        class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 hidden peer-checked:block transition-all duration-300 md:hidden"
      ></label>

      <!-- Mobile Sidebar Drawer Container -->
      <div class="fixed top-0 right-0 w-72 h-full bg-white z-40 shadow-2xl p-6 flex flex-col gap-6 transform translate-x-full transition-transform duration-300 ease-in-out peer-checked:translate-x-0 md:hidden">
        <div class="flex items-center justify-between border-b border-neutral-100 pb-4 mt-4">
          <div class="flex flex-col">
            <span class="font-outfit font-extrabold text-md tracking-tight bg-gradient-to-r from-brand-emerald-950 to-brand-emerald-700 bg-clip-text text-transparent">
              ENDAH RESIDENCE II
            </span>
            <span class="text-[9px] font-bold text-brand-amber-600 tracking-wider">BANDAR • BATANG</span>
          </div>
        </div>

        <nav class="flex flex-col gap-4 font-outfit font-semibold text-neutral-800 tracking-wide mt-4 text-base">
          <a href="/" class="hover:text-brand-emerald-700 py-2 border-b border-neutral-50 transition">Beranda</a>
          <a href="/unit" class="hover:text-brand-emerald-700 py-2 border-b border-neutral-50 transition">Katalog Unit</a>
          <a href="/galeri-progres" class="hover:text-brand-emerald-700 py-2 border-b border-neutral-50 transition">Progres Proyek</a>
          <a href="/tentang-kami" class="hover:text-brand-emerald-700 py-2 border-b border-neutral-50 transition">Tentang Kami</a>
          <a href="/kontak" class="hover:text-brand-emerald-700 py-2 transition">Kontak</a>
        </nav>

        <div class="mt-auto border-t border-neutral-100 pt-6 pb-6">
          <a 
            href="https://wa.me/6282134994060?text=Halo%20Tim%20Endah%20Residence%20II%2C%20saya%20melihat%20informasi%20dari%20Website.%20Saya%20tertarik%20dengan%20perumahan%20Anda%20dan%20ingin%20menanyakan%20informasi%20unit.%20Mohon%20bantuannya." 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center bg-brand-emerald-800 hover:bg-brand-emerald-700 text-white font-outfit font-bold py-3.5 rounded-xl transition duration-300 shadow-md shadow-brand-emerald-800/10 text-center"
          >
            Hubungi Marketing (WA)
          </a>
        </div>
      </div>
      
    </div>
  </div>
</header>

<style>
  /* Custom Tailwind V4 CSS selector peer styling for pure CSS Hamburger drawer */
  #mobile-menu-toggle:checked ~ label[for="mobile-menu-toggle"] span:nth-child(1) {
    transform: rotate(45deg) translate(3px, 1px);
  }
  #mobile-menu-toggle:checked ~ label[for="mobile-menu-toggle"] span:nth-child(2) {
    opacity: 0;
  }
  #mobile-menu-toggle:checked ~ label[for="mobile-menu-toggle"] span:nth-child(3) {
    transform: rotate(-45deg) translate(3px, -1px);
  }
</style>
