---
// src/components/GoogleMapsLocator.astro

// Kita menggunakan variabel environment agar API Key aman dan bisa dikonfigurasi di Vercel.
const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY || "YOUR_API_KEY_HERE";
---

<style>
  gmpx-store-locator {
    width: 100%;
    height: 100%;
    border-radius: 1rem;
    overflow: hidden;

    /* Menyesuaikan warna dengan tema Endah Residence II */
    --gmpx-color-surface: #fff;
    --gmpx-color-on-surface: #212121;
    --gmpx-color-on-surface-variant: #757575;
    --gmpx-color-primary: #1e40af; /* Biru elegan */
    --gmpx-color-outline: #e0e0e0;
    --gmpx-fixed-panel-width-row-layout: 28.5em;
    --gmpx-fixed-panel-height-column-layout: 65%;
    --gmpx-font-family-base: "Plus Jakarta Sans", sans-serif;
    --gmpx-font-family-headings: "Plus Jakarta Sans", sans-serif;
    --gmpx-font-size-base: 0.875rem;
    --gmpx-hours-color-open: #188038;
    --gmpx-hours-color-closed: #d50000;
    --gmpx-rating-color: #ffb300;
    --gmpx-rating-color-empty: #e0e0e0;
  }
</style>

<script is:inline define:vars={{ apiKey }}>
  const CONFIGURATION = {
    "locations": [
      {
        "title": "Endah Residence II",
        "address1": "Jl. Sendang - Tulis",
        "address2": "Sempu, Batiombo, Kec. Bandar, Kabupaten Batang, Jawa Tengah, Indonesia",
        "coords": { "lat": -6.976672297212384, "lng": 109.776307664418 },
        "placeId": "EltKbC4gU2VuZGFuZyAtIFR1bGlzLCBTZW1wdSwgQmF0aW9tYm8sIEtlYy4gQmFuZGFyLCBLYWJ1cGF0ZW4gQmF0YW5nLCBKYXdhIFRlbmdhaCwgSW5kb25lc2lhIi4qLAoUChIJCy6LDTk9cC4RU5l10_XzQX4SFAoSCff_3vg-PXAuES0G-ANKnBAy"
      }
    ],
    "mapOptions": {
      "center": { "lat": -6.976672, "lng": 109.776307 },
      "fullscreenControl": true,
      "mapTypeControl": false,
      "streetViewControl": false,
      "zoom": 15,
      "zoomControl": true,
      "maxZoom": 18,
      "mapId": ""
    },
    "mapsApiKey": apiKey,
    "capabilities": {
      "input": true,
      "autocomplete": true,
      "directions": true,
      "distanceMatrix": true,
      "details": true,
      "actions": false
    }
  };

  document.addEventListener('DOMContentLoaded', async () => {
    await customElements.whenDefined('gmpx-store-locator');
    const locator = document.querySelector('gmpx-store-locator');
    if(locator) {
      locator.configureFromQuickBuilder(CONFIGURATION);
    }
  });
</script>

<script is:inline type="module" src="https://ajax.googleapis.com/ajax/libs/@googlemaps/extended-component-library/0.6.11/index.min.js"></script>

<div class="w-full h-full min-h-[400px]">
  <gmpx-api-loader key={apiKey} solution-channel="GMP_QB_locatorplus_v11_cABCDE"></gmpx-api-loader>
  <gmpx-store-locator map-id="DEMO_MAP_ID"></gmpx-store-locator>
</div>
