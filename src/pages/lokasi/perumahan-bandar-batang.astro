---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Import images
import heroImage from '../../assets/images/hero_estate.png';
import tipe30Image from '../../assets/images/tipe_30_facade.png';

const title = "Info Lengkap Perumahan Bandar Batang Termurah & Aman | Endah Residence II";
const description = "Mencari perumahan di Bandar, Batang? Endah Residence II menawarkan rumah subsidi murah & komersil premium dengan legalitas SHM ready & bebas banjir.";

const faqList = [
  {
    question: "Apakah lokasi perumahan Bandar Batang ini bebas dari sengketa tanah?",
    answer: "Sangat aman. Seluruh area lahan perumahan Endah Residence II di Batiombo Bandar telah berstatus bersertifikat Hak Milik (SHM Induk) yang sah secara hukum dan siap dipecah balik nama ke pembeli."
  },
  {
    question: "Apa keunggulan tinggal di wilayah Bandar Batang?",
    answer: "Bandar terletak di kaki bukit dengan kualitas udara pegunungan sejuk yang bebas dari polusi industri pantai, memiliki pasokan air bersih melimpah, dan berjarak sangat dekat ke fasilitas perkotaan seperti sekolah, pasar, dan Tol Tulis."
  },
  {
    question: "Apakah ada promo keringanan uang muka (DP)?",
    answer: "Ya, kami sering menyelenggarakan promo khusus potongan uang muka (DP) ringan serta subsidi biaya akad perbankan yang bisa dikonsultasikan secara langsung dengan tim marketing kami."
  }
];

const pageUrl = "https://www.endahresidence.online/lokasi/perumahan-bandar-batang";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout title={title} description={description}>
  <!-- Schema injection -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-brand-emerald-50/70 to-white pt-16 pb-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Text Info -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <span class="inline-flex bg-brand-emerald-100 text-brand-emerald-800 text-[10px] font-black px-3.5 py-1 rounded-full uppercase tracking-widest border border-brand-emerald-200">
            SEO Landing Page: Area Bandar Batang
          </span>
          <h1 class="font-outfit font-black text-3xl sm:text-4xl lg:text-5xl text-neutral-900 leading-tight">
            Pusat Informasi Perumahan di Bandar Batang - Endah Residence II
          </h1>
          <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
            Menemukan hunian ideal yang menggabungkan kesegaran alam pegunungan dengan kepastian legalitas hukum kini lebih mudah. Kami menghadirkan solusi perumahan murah, aman, dan berkualitas tinggi di Bandar, Batang.
          </p>
          <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
            <a 
              href="https://wa.me/6282134994060?text=Halo%20Tim%20Endah%20Residence%20II%2C%20saya%20tertarik%20dengan%20informasi%20Perumahan%20Bandar%20Batang%20dari%20website.%20Mohon%20brosurnya." 
              target="_blank" 
              rel="noopener noreferrer"
              class="bg-brand-emerald-800 hover:bg-brand-emerald-700 text-white font-outfit font-bold px-8 py-3.5 rounded-xl transition shadow shadow-brand-emerald-800/10"
            >
              Hubungi Marketing Area Bandar
            </a>
          </div>
        </div>

        <!-- Right Side Mockup -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-xl border-4 border-white">
            <Image 
              src={heroImage} 
              alt="Perumahan murah asri di Bandar Batang Endah Residence II" 
              class="w-full h-auto object-cover"
              sizes="(max-width: 640px) 100vw, 450px"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Detailed Local Area Content -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-12">
      
      <div class="space-y-4">
        <h2 class="font-outfit font-black text-2xl sm:text-3xl text-neutral-900">Mengapa Wilayah Bandar Batang Sangat Cocok untuk Tempat Tinggal?</h2>
        <p class="text-neutral-500 text-sm leading-relaxed">
          Kecamatan Bandar terletak di bagian selatan Kabupaten Batang yang dikenal dengan lanskap dataran tinggi berudara sejuk dan tanah yang subur. Berbeda dengan wilayah pesisir Batang yang berhawa panas dan dikelilingi polusi cerobong pabrik, Bandar menawarkan kualitas hidup premium yang sangat ramah bagi anak-anak dan orang tua.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        <div class="bg-neutral-50 p-6 rounded-2xl border border-neutral-100 space-y-3">
          <h3 class="font-outfit font-bold text-lg text-neutral-800">1. Kualitas Air Artesis Jernih</h3>
          <p class="text-neutral-500 text-xs sm:text-sm">
            Daerah Bandar dilimpahi cadangan air bersih pegunungan yang sangat bersih, tidak berbau, dan melimpah deras sepanjang tahun, bebas dari masalah air asin/payau pesisir.
          </p>
        </div>
        <div class="bg-neutral-50 p-6 rounded-2xl border border-neutral-100 space-y-3">
          <h3 class="font-outfit font-bold text-lg text-neutral-800">2. Fasilitas Umum Lengkap</h3>
          <p class="text-neutral-500 text-xs sm:text-sm">
            Dikelilingi puluhan sarana pendidikan (SD, SMP, SMA Negeri), Pasar Bandar sebagai pusat logistik sembako, kantor perbankan nasional, klinik kesehatan, dan Alun-Alun Bandar.
          </p>
        </div>
      </div>

      <!-- FAQ Summary list (Rich snippet triggers) -->
      <div class="space-y-6 border-t border-neutral-100 pt-12">
        <h2 class="font-outfit font-black text-2xl text-neutral-900">Pertanyaan Umum Mengenai Perumahan Bandar Batang</h2>
        <div class="space-y-4">
          {faqList.map(item => (
            <div class="bg-neutral-50 p-5 rounded-2xl border border-neutral-200/60 space-y-2">
              <h3 class="font-outfit font-bold text-neutral-900 text-base">{item.question}</h3>
              <p class="text-neutral-500 text-xs sm:text-sm leading-relaxed border-t border-neutral-200/50 pt-2">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Action Box -->
      <div class="bg-brand-emerald-950 text-white rounded-3xl p-8 text-center space-y-6">
        <h2 class="font-outfit font-extrabold text-2xl">Miliki Rumah Idaman Anda di Bandar Hari Ini</h2>
        <p class="text-brand-emerald-200 text-xs sm:text-sm max-w-xl mx-auto leading-relaxed">
          Jangan lewatkan sisa unit kavling promo di Endah Residence II. DP bisa dicicil, proses KPR didampingi secara jujur dan transparan hingga serah terima kunci.
        </p>
        <a 
          href="https://wa.me/6282134994060?text=Halo%20Tim%20Endah%20Residence%20II%2C%20saya%20melihat%20halaman%20Perumahan%20Bandar%20Batang%20dari%20website%20dan%20ingin%20tanya-tanya%20detail.%20Mohon%20infonya." 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center bg-brand-amber-500 hover:bg-brand-amber-600 text-white font-outfit font-bold px-8 py-3.5 rounded-xl transition duration-300 shadow shadow-brand-amber-500/20"
        >
          Konsultasi & Atur Jadwal Survey
        </a>
      </div>

    </div>
  </section>
</Layout>
