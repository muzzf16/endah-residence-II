---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Import images
import tipe30Image from '../../assets/images/tipe_30_facade.png';

const title = "Pusat Rumah Subsidi Batang Terlengkap & Bebas Banjir | Endah Residence 2 Batang";
const description = "Mencari info rumah subsidi di Batang? Dapatkan hunian subsidi Tipe 32/60 di Endah Residence 2 Batang Bandar Batang dengan cicilan flat 1 Juta-an, SHM aman.";

const faqList = [
  {
    question: "Apakah suku bunga rumah subsidi bisa naik sewaktu-waktu?",
    answer: "Tidak. Suku bunga KPR Rumah Subsidi dijamin tetap/flat sebesar 5% per tahun oleh pemerintah Republik Indonesia dari awal angsuran hingga lunas (tenor 10, 15, atau 20 tahun)."
  },
  {
    question: "Apa syarat utama mengajukan rumah subsidi di Batang?",
    answer: "Syarat utamanya adalah pemohon berusia 21-55 tahun, berpenghasilan pokok maksimal Rp 8.000.000 per bulan, belum pernah memiliki rumah atas nama pribadi/pasangan, dan memiliki rekam jejak BI checking (SLIK OJK) yang bersih."
  },
  {
    question: "Berapa lama proses pembangunan rumah subsidi setelah disetujui?",
    answer: "Di Endah Residence 2 Batang, kami berkomitmen mempercepat pembangunan berkisar antara 3 - 6 bulan untuk menjamin waktu serah terima kunci yang tepat waktu dan efisien."
  }
];

const pageUrl = "https://www.endahresidence.online/lokasi/rumah-subsidi-batang";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout title={title} description={description}>
  <!-- Schema injection -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-brand-emerald-50/70 to-white pt-16 pb-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Text Info -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <span class="inline-flex bg-brand-emerald-100 text-brand-emerald-800 text-[10px] font-black px-3.5 py-1 rounded-full uppercase tracking-widest border border-brand-emerald-200">
            SEO Landing Page: Rumah Subsidi Batang
          </span>
          <h1 class="font-outfit font-black text-3xl sm:text-4xl lg:text-5xl text-neutral-900 leading-tight">
            Program Rumah Subsidi Terpercaya di Kabupaten Batang
          </h1>
          <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
            Wujudkan impian memiliki rumah sendiri tanpa cemas cicilan melonjak naik. Endah Residence 2 Batang Bandar menghadirkan program KPR rumah subsidi FLPP bersertifikasi legalitas aman (SHM & PBG lengkap) dengan cicilan flat sangat ringan mulai 1 Juta-an.
          </p>
          <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
            <a 
              href="https://wa.me/6282134994060?text=Halo%20Tim%20Endah%2520Residence%20II%2C%20saya%2520tertarik%20dengan%2520informasi%2520Rumah%2520Subsidi%2520Batang%2520dari%2520website.%20Mohon%20brosurnya." 
              target="_blank" 
              rel="noopener noreferrer"
              class="bg-brand-emerald-800 hover:bg-brand-emerald-700 text-white font-outfit font-bold px-8 py-3.5 rounded-xl transition shadow shadow-brand-emerald-800/10"
            >
              Hubungi Spesialis KPR Subsidi
            </a>
          </div>
        </div>

        <!-- Right Side Mockup -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-xl border-4 border-white">
            <Image 
              src={tipe30Image} 
              alt="Program rumah subsidi Tipe 32 murah bebas banjir di Batang" 
              class="w-full h-auto object-cover"
              sizes="(max-width: 640px) 100vw, 450px"
              loading="eager"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Detailed Local Area Content -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-12">
      
      <div class="space-y-4">
        <h2 class="font-outfit font-black text-2xl sm:text-3xl text-neutral-900">Keunggulan KPR FLPP (Subsidi Pemerintah)</h2>
        <p class="text-neutral-500 text-sm leading-relaxed">
          KPR FLPP (Fasilitas Likuiditas Pembiayaan Perumahan) merupakan program bantuan pemerintah yang bertujuan memudahkan masyarakat berpenghasilan rendah mendapatkan rumah pertamanya secara terjangkau.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-neutral-50 p-6 rounded-2xl border border-neutral-100 space-y-2 text-center">
          <span class="block font-outfit font-black text-3xl text-brand-emerald-800">5%</span>
          <span class="font-outfit font-bold text-neutral-800 text-sm block">Suku Bunga Flat</span>
          <p class="text-neutral-500 text-xs leading-normal">Bunga tetap 5% tidak akan naik meskipun kondisi ekonomi pasar melonjak.</p>
        </div>
        <div class="bg-neutral-50 p-6 rounded-2xl border border-neutral-100 space-y-2 text-center">
          <span class="block font-outfit font-black text-3xl text-brand-emerald-800">20 Thn</span>
          <span class="font-outfit font-bold text-neutral-800 text-sm block">Tenor Fleksibel</span>
          <p class="text-neutral-500 text-xs leading-normal">Masa cicilan KPR panjang dan fleksibel mulai 10, 15, hingga 20 tahun.</p>
        </div>
        <div class="bg-neutral-50 p-6 rounded-2xl border border-neutral-100 space-y-2 text-center">
          <span class="block font-outfit font-black text-3xl text-brand-emerald-800">Ringan</span>
          <span class="font-outfit font-bold text-neutral-800 text-sm block">Cicilan Terjangkau</span>
          <p class="text-neutral-500 text-xs leading-normal">Cicilan flat bulanan berkisar di angka 1 Juta-an, setara biaya kontrak kos.</p>
        </div>
      </div>

      <!-- FAQ Summary list (Rich snippet triggers) -->
      <div class="space-y-6 border-t border-neutral-100 pt-12">
        <h2 class="font-outfit font-black text-2xl text-neutral-900">Pertanyaan Sering Diajukan Tentang Rumah Subsidi Batang</h2>
        <div class="space-y-4">
          {faqList.map(item => (
            <div class="bg-neutral-50 p-5 rounded-2xl border border-neutral-200/60 space-y-2">
              <h3 class="font-outfit font-bold text-neutral-900 text-base">{item.question}</h3>
              <p class="text-neutral-500 text-xs sm:text-sm leading-relaxed border-t border-neutral-200/50 pt-2">{item.answer}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Action Box -->
      <div class="bg-brand-emerald-950 text-white rounded-3xl p-8 text-center space-y-6">
        <h2 class="font-outfit font-extrabold text-2xl">Miliki Rumah Pertama Anda dengan Cicilan Flat Terjamin</h2>
        <p class="text-brand-emerald-200 text-xs sm:text-sm max-w-xl mx-auto leading-relaxed">
          Jangan ragu untuk mengonsultasikan kelayakan BI checking atau berkas administrasi KPR Anda secara santai bersama spesialis perumahan subsidi kami.
        </p>
        <a 
          href="https://wa.me/6282134994060?text=Halo%20Tim%20Endah%20Residence%20II%2C%20saya%20melihat%20halaman%20Rumah%20Subsidi%20Batang%20dari%20website%20dan%20ingin%20tanya%20mengenai%20syarat%20KPR.%20Mohon%20bantuannya." 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center bg-brand-amber-500 hover:bg-brand-amber-600 text-white font-outfit font-bold px-8 py-3.5 rounded-xl transition duration-300 shadow shadow-brand-amber-500/20"
        >
          Konsultasi Kelayakan KPR Gratis
        </a>
      </div>

    </div>
  </section>
</Layout>
