              <span class="text-xs font-semibold text-neutral-500">Aman & Terbit</span>
            </div>
            <div class="bg-white/60 backdrop-blur-sm p-3 rounded-xl border border-neutral-100">
              <span class="block font-outfit font-black text-xl text-brand-emerald-800">20 Menit</span>
              <span class="text-xs font-semibold text-neutral-500">Ke KIT Batang</span>
            </div>
          </div>

        </div>
        
