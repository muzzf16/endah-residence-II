              </div>
              <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2.5 py-1 rounded-full uppercase">Terpercaya</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- USP & Trust Signals Section -->
  <section class="py-16 bg-white border-y border-neutral-100">
