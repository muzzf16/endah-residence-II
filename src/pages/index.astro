      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 max-w-5xl mx-auto">
        
        <!-- Unit Card 1: Tipe 32 Subsidi -->
        <div class="bg-white rounded-3xl overflow-hidden shadow-xl border border-neutral-100 hover:shadow-2xl hover:-translate-y-1 transition duration-300 flex flex-col">
          <div class="relative h-64 sm:h-72">
            <Image 
