---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import GoogleRankTrust from '../components/GoogleRankTrust.astro';

// Import local generated property assets
import heroImage from '../assets/images/hero_estate.png';
import tipe30Image from '../assets/images/tipe_30_facade.png';
import tipe36Image from '../assets/images/tipe_36_facade.png';
import progressRoad from '../assets/images/progress_road.png';
import progressHandover from '../assets/images/progress_handover.png';
import interiorMockup from '../assets/images/interior_mockup.png';

const title = "Endah Residence 2 Batang - Pilihan Perumahan Batang Terbaik & Murah";
const description = "Cari perumahan Batang murah dan aman? Endah Residence 2 Bandar menawarkan rumah subsidi terbaik dekat kawasan industri KITB dengan sertifikat SHM ready.";
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-brand-emerald-50/70 to-white pt-12 pb-20 md:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Hero Text Info -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 bg-brand-emerald-100/60 border border-brand-emerald-200 text-brand-emerald-900 px-4 py-1.5 rounded-full text-xs font-bold font-outfit tracking-wide uppercase">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-emerald-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-emerald-600"></span>
            </span>
            PROMO DP RINGAN & CICILAN FLAT 2026
          </div>
          
          <!-- Local SEO Core H1 Headline -->
          <h1 class="font-outfit font-extrabold text-4xl sm:text-5xl lg:text-6xl text-neutral-900 leading-tight">
            Hunian Terbaik & Aman di <span class="bg-gradient-to-r from-brand-emerald-800 to-brand-emerald-600 bg-clip-text text-transparent">Bandar Batang</span>
          </h1>
          
          <p class="text-neutral-600 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed">
            Miliki rumah impian keluarga Anda di <strong>Endah Residence 2</strong>, pilihan utama <strong>perumahan di Batang Jawa Tengah</strong>. Temukan rekomendasi <strong>perumahan subsidi Batang</strong> terbaik dengan legalitas 100% aman (SHM & PBG siap balik nama).
          </p>

          <!-- Call to actions -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start pt-2">
            <a 
              href="https://wa.me/6287880211288?text=Halo%20Tim%20Endah%20Residence%20II%2C%20saya%20melihat%20informasi%20dari%20Website.%20Saya%20tertarik%20dengan%20perumahan%20Anda%20dan%20ingin%20tanya%20mengenai%20unit.%20Mohon%20infonya." 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center bg-brand-emerald-800 hover:bg-brand-emerald-700 text-white font-outfit font-bold px-8 py-4 rounded-2xl transition duration-300 shadow-xl shadow-brand-emerald-800/20 hover:scale-[1.02] active:scale-[0.98] text-base"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              Konsultasi WhatsApp (Gratis)
            </a>
            
            <a 
              href="#lokasi" 
              class="inline-flex items-center justify-center bg-white hover:bg-neutral-50 text-neutral-800 border-2 border-neutral-200 font-outfit font-bold px-8 py-4 rounded-2xl transition duration-300 hover:scale-[1.02] active:scale-[0.98] text-base"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
