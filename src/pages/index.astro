        <div class="lg:col-span-5 relative flex justify-center">
          <div class="absolute -inset-4 bg-gradient-to-tr from-brand-emerald-500 to-brand-amber-500 rounded-3xl opacity-10 blur-2xl"></div>
          <div class="relative w-full max-w-md sm:max-w-lg lg:max-w-full rounded-2xl overflow-hidden shadow-2xl border-4 border-white transform hover:scale-[1.01] transition duration-500">
            <Image 
              src={heroImage} 
              alt="Perumahan Endah Residence 2 Batang Bandar Batang modern estate banner" 
              class="w-full h-auto object-cover"
              sizes="(max-width: 640px) 100vw, 600px"
              loading="eager"
            />
            <div class="absolute bottom-4 left-4 right-4 bg-white/95 backdrop-blur-md p-4 rounded-xl shadow-lg border border-neutral-100/50 flex items-center justify-between">
              <div>
