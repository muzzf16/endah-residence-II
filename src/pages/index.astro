        <div>
          <span class="text-xs font-bold text-brand-amber-600 tracking-widest uppercase block mb-1">Katalog Rumah Pilihan</span>
          <h2 class="font-outfit font-extrabold text-3xl text-neutral-900">Pilihan Unit Perumahan Batang Kami</h2>
        </div>
        <a 
          href="/unit" 
          class="inline-flex items-center text-sm font-bold text-brand-emerald-800 hover:text-brand-emerald-600 transition"
