  <!-- Client-Side Dashboard and Custozimer JavaScripts -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      
      // 1. DYNAMIC NAVIGATION TABS
      const tabPanels = {
        overview: document.getElementById('panel-overview'),
        articles: document.getElementById('panel-articles'),
        seo: document.getElementById('panel-seo'),
        theme: document.getElementById('panel-theme'),
        assets: document.getElementById('panel-assets')
      };

      const tabButtons = {
        overview: document.getElementById('tab-btn-overview'),
        articles: document.getElementById('tab-btn-articles'),
        seo: document.getElementById('tab-btn-seo'),
        theme: document.getElementById('tab-btn-theme'),
        assets: document.getElementById('tab-btn-assets')
      };

      function activateTab(tabId) {
        Object.keys(tabPanels).forEach(key => {
          if (key === tabId) {
            tabPanels[key].classList.remove('hidden');
            tabButtons[key].className = "tab-btn px-4 py-2 rounded-xl text-xs font-bold font-outfit uppercase tracking-wider transition-all duration-300 bg-brand-emerald-800 text-white shadow";
          } else {
            tabPanels[key].classList.add('hidden');
            tabButtons[key].className = "tab-btn px-4 py-2 rounded-xl text-xs font-bold font-outfit uppercase tracking-wider transition-all duration-300 text-neutral-400 hover:text-white";
          }
        });
      }

      Object.keys(tabButtons).forEach(key => {
        tabButtons[key].addEventListener('click', () => activateTab(key));
      });


      // 2. MOCKED ARTICLES LOCAL DATABASE
      const mockArticles = [
        {
          id: "syarat-kpr-subsidi-batang",
          title: "Syarat Lengkap KPR Rumah Subsidi di Batang Terbaru 2026",
          description: "Panduan lengkap syarat KPR rumah subsidi di Kabupaten Batang. Ketahui batasan gaji, dokumen penting, dan tips lolos BI checking KPR BTN Syariah mudah.",
          category: "kpr",
          author: "Tim Sales Endah Residence II",
          date: "2026-05-27",
          keyword: "KPR subsidi",
          body: `Memiliki rumah pribadi di usia muda kini bukan lagi sekadar impian. Pemerintah Indonesia terus menyelenggarakan program FLPP atau KPR Subsidi untuk membantu masyarakat berpenghasilan rendah mendapatkan hunian pertamanya.\n\nJika Anda berencana mengambil rumah subsidi di Kabupaten Batang—khususnya di Endah Residence II Bandar—maka sangat penting bagi Anda untuk memahami syarat dan dokumen administratif yang diperlukan agar pengajuan KPR Anda disetujui 100% oleh perbankan.`,
          faq: [
            { q: "Berapa batas maksimal penghasilan untuk KPR subsidi di Batang?", a: "Batas penghasilan pokok maksimal untuk mengajukan KPR subsidi (FLPP) adalah Rp 8.000.000 per bulan." },
            { q: "Apakah bisa mengajukan KPR subsidi jika memiliki cicilan motor?", a: "Bisa, asalkan rasio hutang bulanan Anda (DSR) masih di bawah 30-40% dari total penghasilan bersih." }
          ]
        },
        {
          id: "tips-beli-rumah-pertama-batang",
          title: "5 Tips Cerdas Membeli Rumah Pertama di Bandar Batang",
          description: "Panduan lengkap tips membeli rumah pertama di Bandar, Batang bagi pemula. Pelajari cara survei lokasi, cek legalitas SHM, dan menentukan budget cicilan ideal.",
          category: "properti",
          author: "Tim Sales Endah Residence II",
          date: "2026-05-27",
          keyword: "rumah pertama",
          body: `Membeli rumah pertama adalah salah satu keputusan keuangan terbesar dalam hidup Anda. Bagi sebagian orang, proses mencari rumah di daerah berkembang seperti Kabupaten Batang bisa terasa membingungkan karena banyaknya tawaran dari berbagai developer.\n\nDaerah Bandar, Batang kini menjadi primadona baru bagi para pencari rumah karena lokasinya yang asri di dataran tinggi namun dekat dengan jalan tol dan zona industri.`,
          faq: [
            { q: "Berapa booking fee rata-rata perumahan di Bandar Batang?", a: "Booking fee untuk perumahan di area Bandar berkisar antara Rp 1.000.000 hingga Rp 2.000.000." },
            { q: "Bagaimana cara memeriksa legalitas tanah perumahan?", a: "Anda wajib menanyakan kepemilikan sertifikat induk (SHM) dan izin PBG/IMB kepada pihak developer." }
          ]
        },
        {
          id: "perkembangan-kawasan-industri-batang",
          title: "Dampak KITB terhadap Tren Investasi Properti di Bandar Batang",
          description: "Analisis lengkap dampak Kawasan Industri Terpadu Batang (KITB) terhadap naiknya nilai investasi properti dan hunian sewa di area Bandar Batang.",
          category: "investasi",
          author: "Tim Pemasaran Resmi Endah Residence II",
          date: "2026-05-27",
          keyword: "KIT Batang",
          body: `Proyek Strategis Nasional Kawasan Industri Terpadu Batang (KITB) atau Grand Batang City yang membentang seluas ribuan hektar kini telah resmi beroperasi. Masuknya investasi raksasa asing secara drastis mengubah peta ekonomi Jawa Tengah.\n\nDampak dari pertumbuhan ekonomi KITB ini tidak hanya dirasakan di area pesisir Batang saja, melainkan meluas pesat hingga ke wilayah Bandar, Batang.`,
          faq: [
            { q: "Berapa jarak dari Bandar Batang menuju Kawasan Industri Terpadu Batang (KITB)?", a: "Jaraknya sangat dekat, hanya sekitar 20 menit berkendara melalui rute komuter Bandar-Tulis." }
          ]
        }
      ];

      const articlesListContainer = document.getElementById('articles-list-container');
      const editorEditingBadge = document.getElementById('editor-editing-badge');

      function renderArticlesList() {
        articlesListContainer.innerHTML = '';
        mockArticles.forEach((art) => {
          const card = document.createElement('div');
          card.className = "bg-neutral-900 border border-neutral-800 rounded-3xl p-5 flex flex-col justify-between space-y-4 hover:border-brand-emerald-800/35 transition";
          card.innerHTML = `
            <div class="space-y-2">
              <span class="text-[9px] bg-neutral-950 border border-neutral-800 text-neutral-400 font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">
                ${art.category.toUpperCase()}
              </span>
              <h3 class="font-outfit font-bold text-lg text-white line-clamp-2">${art.title}</h3>
              <p class="text-xs text-neutral-500 line-clamp-3 leading-normal">${art.description}</p>
            </div>
            <div class="flex justify-between items-center border-t border-neutral-800 pt-3 text-xs font-bold">
              <span class="text-[10px] text-neutral-500">${art.date}</span>
              <button class="bg-brand-emerald-900/30 hover:bg-brand-emerald-800 text-emerald-400 hover:text-white px-3.5 py-1.5 rounded-xl border border-brand-emerald-800/30 transition">
                Muat & Edit
              </button>
            </div>
          `;
          card.querySelector('button').addEventListener('click', () => {
            loadArticleToEditor(art);
          });
          articlesListContainer.appendChild(card);
        });
      }

      // Initial render
      renderArticlesList();

      document.getElementById('btn-create-new-article').addEventListener('click', () => {
        // Reset form to write new
        document.getElementById('seo-input-keyword').value = '';
        document.getElementById('seo-input-title').value = '';
        document.getElementById('seo-input-desc').value = '';
        document.getElementById('seo-input-body').value = '';
        document.getElementById('seo-input-category').value = 'kpr';
        document.getElementById('seo-input-author').value = 'Tim Sales Endah Residence II';
        document.getElementById('seo-input-date').value = new Date().toISOString().split('T')[0];
        editorFaqs.length = 0;
        renderEditorFAQs();
        editorEditingBadge.className = "bg-brand-emerald-800/20 text-brand-emerald-400 border border-brand-emerald-800/30 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-wider";
        editorEditingBadge.textContent = "Mode: Membuat Baru";
        activateTab('seo');
        calculateSEOScore();
        compileMarkdown();
      });


      // 3. EDIT & AUDIT ENGINE
      const keywordInput = document.getElementById('seo-input-keyword');
      const titleInput = document.getElementById('seo-input-title');
      const descInput = document.getElementById('seo-input-desc');
      const bodyInput = document.getElementById('seo-input-body');
      const categoryInput = document.getElementById('seo-input-category');
      const authorInput = document.getElementById('seo-input-author');
      const dateInput = document.getElementById('seo-input-date');

      // Count holders
      const titleCountText = document.getElementById('char-count-title');
      const descCountText = document.getElementById('char-count-desc');
      const bodyCountText = document.getElementById('word-count-body');

      // Circular gauge score
      const scoreRing = document.getElementById('seo-score-glow');
      const scoreText = document.getElementById('seo-score-text');
      const scoreGrade = document.getElementById('seo-score-grade');

      // SERP Mockups
      const serpTitle = document.getElementById('serp-preview-title');
      const serpDesc = document.getElementById('serp-preview-desc');
      const serpUrl = document.getElementById('serp-preview-url');
      const serpMobileBtn = document.getElementById('btn-serp-mobile');
      const serpDesktopBtn = document.getElementById('btn-serp-desktop');
      const serpBox = document.getElementById('serp-preview-box');

      // Checklist elements
      const checks = {
        titleLen: document.getElementById('check-title-len'),
        descLen: document.getElementById('check-desc-len'),
        keywordTitle: document.getElementById('check-keyword-title'),
        keywordDesc: document.getElementById('check-keyword-desc'),
        keywordBody: document.getElementById('check-keyword-body')
      };

      const codeOutput = document.getElementById('code-output-box');
      const copyBtn = document.getElementById('btn-copy-code');

      const editorFaqs = [];

      function loadArticleToEditor(art) {
        keywordInput.value = art.keyword;
        titleInput.value = art.title;
        descInput.value = art.description;
        bodyInput.value = art.body;
        categoryInput.value = art.category;
        authorInput.value = art.author;
        dateInput.value = art.date;

        editorFaqs.length = 0;
        art.faq.forEach(f => editorFaqs.push(f));
        
        renderEditorFAQs();

        editorEditingBadge.className = "bg-amber-500/20 text-brand-amber-500 border border-brand-amber-500/30 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-wider";
        editorEditingBadge.textContent = `Mode: Mengedit ${art.id}.md`;

        activateTab('seo');
        calculateSEOScore();
        compileMarkdown();
      }

      function calculateSEOScore() {
        const keyword = keywordInput.value.trim().toLowerCase();
        const title = titleInput.value.trim();
        const desc = descInput.value.trim();
        const body = bodyInput.value.trim();
        const category = categoryInput.value;

        // 1. Form counters
        titleCountText.textContent = `${title.length} Karakter`;
        descCountText.textContent = `${desc.length} Karakter`;
        const words = body ? body.split(/\s+/).filter(Boolean).length : 0;
        bodyCountText.textContent = `${words} Kata`;

        // 2. Score metrics calculations
        let score = 0;

        const isTitleLenValid = title.length >= 45 && title.length <= 65;
        setCheckState(checks.titleLen, isTitleLenValid);
        if (isTitleLenValid) score += 20;

        const isDescLenValid = desc.length >= 110 && desc.length <= 170;
        setCheckState(checks.descLen, isDescLenValid);
        if (isDescLenValid) score += 20;

        const isKeywordInTitle = keyword && title.toLowerCase().includes(keyword);
        setCheckState(checks.keywordTitle, isKeywordInTitle);
        if (isKeywordInTitle) score += 20;

        const isKeywordInDesc = keyword && desc.toLowerCase().includes(keyword);
        setCheckState(checks.keywordDesc, isKeywordInDesc);
        if (isKeywordInDesc) score += 20;

        let density = 0;
        if (keyword && words > 0) {
          const occurrences = (body.toLowerCase().match(new RegExp(escapeRegex(keyword), 'g')) || []).length;
          density = (occurrences / words) * 100;
        }
        const isKeywordBodyValid = density >= 0.5 && density <= 3.0;
        setCheckState(checks.keywordBody, isKeywordBodyValid);
        if (isKeywordBodyValid) score += 20;

        // Update radial progress indicator
        scoreText.textContent = score;

        if (score < 50) {
          scoreRing.className = "absolute inset-1 rounded-full border-8 border-red-600 shadow-lg shadow-red-500/20 transition-all duration-300";
          scoreGrade.textContent = "Butuh Optimasi";
          scoreGrade.className = "font-outfit font-bold text-sm text-red-500 block uppercase";
        } else if (score < 80) {
          scoreRing.className = "absolute inset-1 rounded-full border-8 border-amber-500 shadow-lg shadow-amber-500/20 transition-all duration-300";
          scoreGrade.textContent = "Cukup Baik";
          scoreGrade.className = "font-outfit font-bold text-sm text-amber-500 block uppercase";
        } else {
          scoreRing.className = "absolute inset-1 rounded-full border-8 border-emerald-600 shadow-lg shadow-emerald-500/20 transition-all duration-300";
          scoreGrade.textContent = "SEO Sangat Optimal";
          scoreGrade.className = "font-outfit font-bold text-sm text-emerald-500 block uppercase";
        }

        // 3. Highlight keyword occurrences in Google simulator
        let highlightedTitle = title || "Ketik Judul SEO Halaman";
        let highlightedDesc = desc || "Ketik deskripsi meta halaman Anda...";
        
        if (keyword) {
          const regex = new RegExp(`(${escapeRegex(keyword)})`, 'gi');
          highlightedTitle = highlightedTitle.replace(regex, '<strong>$1</strong>');
          highlightedDesc = highlightedDesc.replace(regex, '<strong>$1</strong>');
        }

        serpTitle.innerHTML = highlightedTitle;
        serpDesc.innerHTML = highlightedDesc;
        serpUrl.textContent = `https://endahresidence.com > blog > ${category}`;
      }

      function setCheckState(elem, isValid) {
        if (isValid) {
          elem.className = "w-4 h-4 rounded-full flex items-center justify-center text-[9px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0";
          elem.textContent = "✓";
        } else {
          elem.className = "w-4 h-4 rounded-full flex items-center justify-center text-[9px] font-bold bg-red-500/10 text-red-400 border border-red-500/20 shrink-0";
          elem.textContent = "✗";
        }
      }

      function escapeRegex(string) {
        return string.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
      }

      function renderEditorFAQs() {
        const builderFaqContainer = document.getElementById('builder-faq-container');
        builderFaqContainer.innerHTML = '';
        editorFaqs.forEach((item, idx) => {
          const div = document.createElement('div');
          div.className = "flex justify-between items-center bg-neutral-950 p-2 rounded-xl border border-neutral-800 gap-4";
          div.innerHTML = `
            <div class="truncate">
              <span class="font-bold text-neutral-300 block">Q: ${item.q}</span>
              <span class="text-neutral-500 block truncate">A: ${item.a}</span>
            </div>
            <button type="button" class="text-red-500 hover:text-red-400 font-bold shrink-0 text-[10px] uppercase">Hapus</button>
          `;
          div.querySelector('button').addEventListener('click', () => {
            editorFaqs.splice(idx, 1);
            renderEditorFAQs();
            compileMarkdown();
          });
          builderFaqContainer.appendChild(div);
        });
      }

      document.getElementById('btn-builder-add-faq').addEventListener('click', () => {
        const q = document.getElementById('builder-faq-q').value.trim();
        const a = document.getElementById('builder-faq-a').value.trim();
        if (q && a) {
          editorFaqs.push({ q, a });
          document.getElementById('builder-faq-q').value = '';
          document.getElementById('builder-faq-a').value = '';
          renderEditorFAQs();
          compileMarkdown();
        }
      });

      function compileMarkdown() {
        const title = titleInput.value.trim() || "Judul Draf Artikel";
        const category = categoryInput.value;
        const author = authorInput.value.trim() || "Tim Sales Endah Residence II";
        const desc = descInput.value.trim() || "Deskripsi meta halaman draf...";
        const body = bodyInput.value.trim() || "Isi artikel...";
        const date = dateInput.value || new Date().toISOString().split('T')[0];

        let md = `---
title: "${title}"
description: "${desc}"
publishDate: "${date}"
category: "${category}"
tags: ["Endah Residence II", "Rumah Baru", "Batang"]
image: "/src/assets/images/hero_estate.png"
author: "${author}"`;

        if (editorFaqs.length > 0) {
          md += `\nfaq:`;
          editorFaqs.forEach(item => {
            md += `\n  - question: "${item.q}"\n    answer: "${item.a}"`;
          });
        }

        md += `\n---\n\n${body}`;
        codeOutput.textContent = md;
      }

      [keywordInput, titleInput, descInput, bodyInput, categoryInput, authorInput, dateInput].forEach(elem => {
        elem.addEventListener('input', () => {
          calculateSEOScore();
          compileMarkdown();
        });
      });

      // Google SERP Viewports switch
      serpMobileBtn.addEventListener('click', () => {
        serpMobileBtn.className = "px-2 py-0.5 rounded bg-brand-emerald-800 text-white";
        serpDesktopBtn.className = "px-2 py-0.5 rounded text-neutral-500 hover:text-white";
        serpBox.className = "bg-white text-neutral-900 p-4 rounded-xl border border-neutral-200/80 space-y-1 font-sans text-left max-w-sm sm:max-w-md mx-auto transition-all duration-300";
      });

      serpDesktopBtn.addEventListener('click', () => {
        serpDesktopBtn.className = "px-2 py-0.5 rounded bg-brand-emerald-800 text-white";
        serpMobileBtn.className = "px-2 py-0.5 rounded text-neutral-500 hover:text-white";
        serpBox.className = "bg-white text-neutral-900 p-4 rounded-xl border border-neutral-200/80 space-y-1 font-sans text-left w-full max-w-none mx-0 transition-all duration-300";
      });

      copyBtn.addEventListener('click', () => {
        const range = document.createRange();
        range.selectNode(codeOutput);
        window.getSelection().removeAllRanges();
        window.getSelection().addRange(range);
        document.execCommand('copy');
        window.getSelection().removeAllRanges();

        const origText = copyBtn.textContent;
        copyBtn.textContent = "COPIED!";
        copyBtn.className = "bg-brand-emerald-800 text-white px-3 py-1 rounded-lg text-[9px] font-bold uppercase transition";
        setTimeout(() => {
          copyBtn.textContent = origText;
          copyBtn.className = "bg-neutral-950 hover:bg-neutral-800 border border-neutral-800 text-neutral-300 px-3 py-1 rounded-lg text-[9px] font-bold uppercase transition";
        }, 1500);
      });

      // Default date to today
      dateInput.value = new Date().toISOString().split('T')[0];

      // Set initial defaults
      calculateSEOScore();
      compileMarkdown();


      // 4. THEME & COLORS DESIGNER ENGINE
      const pickerPrimary = document.getElementById('theme-color-primary');
      const pickerAccent = document.getElementById('theme-color-accent');
      const pickerBg = document.getElementById('theme-color-bg');

      const hexLabelPrimary = document.getElementById('hex-label-primary');
      const hexLabelAccent = document.getElementById('hex-label-accent');
      const hexLabelBg = document.getElementById('hex-label-bg');

      const previewBg = document.getElementById('theme-preview-card-bg');
      const previewBadge = document.getElementById('theme-preview-badge');
      const previewTitle = document.getElementById('theme-preview-title');
      const previewPrice = document.getElementById('theme-preview-price');
      const previewBtn = document.getElementById('theme-preview-btn');

      const cssOutputBox = document.getElementById('compiled-theme-css-box');

      function updateThemeCustomizations() {
        const primaryHex = pickerPrimary.value;
        const accentHex = pickerAccent.value;
        const bgHex = pickerBg.value;

        // Update hex labels
        hexLabelPrimary.textContent = primaryHex;
        hexLabelAccent.textContent = accentHex;
        hexLabelBg.textContent = bgHex;

        // Apply style rules dynamically to Live Preview Card
        previewBg.style.backgroundColor = bgHex;
        previewBadge.style.backgroundColor = primaryHex;
        previewTitle.style.color = primaryHex;
        previewPrice.style.color = accentHex;
        previewBtn.style.backgroundColor = primaryHex;

        // Compile Tailwind CSS v4 directives code block
        const compiledCss = `@theme {
  /* Brand Colors - Custom Primary (Stability, Nature, Trust) */
  --color-brand-emerald-900: ${primaryHex};

  /* Accent Colors - Custom Accent (Conversion, Premium highlights) */
  --color-brand-amber-600: ${accentHex};

  /* Custom Page Background Color */
  --color-neutral-50: ${bgHex};
}`;
        cssOutputBox.textContent = compiledCss;
      }

      [pickerPrimary, pickerAccent, pickerBg].forEach(picker => {
        picker.addEventListener('input', updateThemeCustomizations);
      });

      // Run theme initialization
      updateThemeCustomizations();

    });
  </script>
</Layout>
