---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Import images for local asset manager listings
import heroImage from '../../assets/images/hero_estate.png';
import tipe30Image from '../../assets/images/tipe_30_facade.png';
import tipe36Image from '../../assets/images/tipe_36_facade.png';
import progressRoad from '../../assets/images/progress_road.png';
import progressHandover from '../../assets/images/progress_handover.png';
import interiorMockup from '../../assets/images/interior_mockup.png';

const title = "Dashboard Pemasaran & SEO Tool | Endah Residence II";
const description = "Kelola draf halaman, lakukan audit kata kunci SEO lokal secara real-time, dan simulasikan Google SERP desktop serta seluler.";
---

<Layout title={title} description={description}>
  <!-- Enforce absolute search engine non-indexation for admin portal -->
  <meta name="robots" content="noindex, nofollow" slot="head" />

  <div class="min-h-screen bg-neutral-950 text-neutral-100 font-sans pb-16">
    
    <!-- Admin Hero Cover -->
    <div class="bg-gradient-to-r from-neutral-900 via-brand-emerald-950 to-neutral-900 border-b border-neutral-800 py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto flex flex-col xl:flex-row justify-between items-center gap-6">
        <div class="flex items-center gap-4 text-center sm:text-left">
          <div class="w-12 h-12 rounded-2xl bg-brand-emerald-600 flex items-center justify-center shadow-lg shadow-brand-emerald-600/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <h1 class="font-outfit font-black text-2xl tracking-tight text-white leading-none">ADMIN CONTROL PANEL</h1>
            <p class="text-xs text-neutral-400 font-medium mt-1.5">Kelola Artikel • Desain Warna/Background • Optimasi Gambar • SEO Grader</p>
          </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="flex flex-wrap gap-1.5 bg-neutral-900 border border-neutral-800 p-1.5 rounded-2xl">
          <button id="tab-btn-overview" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold font-outfit uppercase tracking-wider transition-all duration-300 bg-brand-emerald-800 text-white shadow">
            Overview
          </button>
          <button id="tab-btn-articles" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold font-outfit uppercase tracking-wider transition-all duration-300 text-neutral-400 hover:text-white">
            Artikel
          </button>
          <button id="tab-btn-seo" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold font-outfit uppercase tracking-wider transition-all duration-300 text-neutral-400 hover:text-white">
            SEO Grader
          </button>
          <button id="tab-btn-theme" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold font-outfit uppercase tracking-wider transition-all duration-300 text-neutral-400 hover:text-white">
            Tema Warna
          </button>
          <button id="tab-btn-assets" class="tab-btn px-4 py-2 rounded-xl text-xs font-bold font-outfit uppercase tracking-wider transition-all duration-300 text-neutral-400 hover:text-white">
            Gambar/Assets
          </button>
        </div>
      </div>
    </div>

    <!-- Active Panels Area -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10">
      
      <!-- 1. OVERVIEW PANEL -->
      <div id="panel-overview" class="tab-panel space-y-10">
        
        <!-- Status Grid Widgets -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-6 relative overflow-hidden group hover:border-brand-emerald-800/50 transition duration-300">
            <div class="absolute -inset-4 bg-brand-emerald-500 rounded-full opacity-0 group-hover:opacity-5 blur-2xl transition duration-500"></div>
            <div class="flex justify-between items-start">
              <div>
                <span class="text-xs font-bold text-neutral-400 block mb-1">TOTAL HALAMAN AKTIF</span>
                <span class="font-outfit font-black text-4xl text-white block">16 Halaman</span>
              </div>
              <span class="bg-emerald-500/10 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-500/20">Synced</span>
            </div>
            <span class="text-[10px] text-neutral-500 block mt-4">Struktur Silo terorganisir 100% Google-ready.</span>
          </div>

          <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-6 relative overflow-hidden group hover:border-brand-emerald-800/50 transition duration-300">
            <div class="absolute -inset-4 bg-brand-emerald-500 rounded-full opacity-0 group-hover:opacity-5 blur-2xl transition duration-500"></div>
            <div class="flex justify-between items-start">
              <div>
                <span class="text-xs font-bold text-neutral-400 block mb-1">OPTIMASI KOMPRESI GAMBAR</span>
                <span class="font-outfit font-black text-4xl text-white block">82% Hemat</span>
              </div>
              <span class="bg-amber-500/10 text-brand-amber-500 text-[10px] font-bold px-2 py-0.5 rounded-full border border-brand-amber-500/20">WebP Active</span>
            </div>
            <span class="text-[10px] text-neutral-500 block mt-4">Mengurangi LCP seluler hingga di bawah 2.5 detik.</span>
          </div>

          <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-6 relative overflow-hidden group hover:border-brand-emerald-800/50 transition duration-300">
            <div class="absolute -inset-4 bg-brand-emerald-500 rounded-full opacity-0 group-hover:opacity-5 blur-2xl transition duration-500"></div>
            <div class="flex justify-between items-start">
              <div>
                <span class="text-xs font-bold text-neutral-400 block mb-1">GOOGLE SITEMAP.XML</span>
                <span class="font-outfit font-black text-4xl text-emerald-400 block">Aktif</span>
              </div>
              <span class="bg-emerald-500/10 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-500/20">Valid</span>
            </div>
            <span class="text-[10px] text-neutral-500 block mt-4">Tersimpan di /sitemap-index.xml otomatis.</span>
          </div>

          <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-6 relative overflow-hidden group hover:border-brand-emerald-800/50 transition duration-300">
            <div class="absolute -inset-4 bg-brand-emerald-500 rounded-full opacity-0 group-hover:opacity-5 blur-2xl transition duration-500"></div>
            <div class="flex justify-between items-start">
              <div>
                <span class="text-xs font-bold text-neutral-400 block mb-1">NAP LOCAL SEO STATUS</span>
                <span class="font-outfit font-black text-4xl text-emerald-400 block">Sinkron</span>
              </div>
              <span class="bg-emerald-500/10 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-500/20">NAP OK</span>
            </div>
            <span class="text-[10px] text-neutral-500 block mt-4">Nama, alamat, telp konsisten di seluruh halaman footer.</span>
          </div>
        </div>

        <!-- Technical SEO Audit Checklist Card -->
        <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-8 space-y-6">
          <div class="border-b border-neutral-800 pb-4">
            <h2 class="font-outfit font-black text-xl text-white">Panduan Verifikasi & Persiapan Sebelum Publikasi</h2>
            <p class="text-xs text-neutral-400">Pastikan seluruh langkah berikut telah diperiksa sebelum Anda melakukan hosting langsung di Vercel.</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
            <div class="space-y-4">
              <div class="flex gap-3">
                <span class="w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">✓</span>
                <div>
                  <span class="font-bold text-white block">Tinjau robots.txt & Sitemap</span>
                  <span class="text-xs text-neutral-500 block">Pastikan Googlebot diizinkan merayap melalui robots.txt dan URL sitemap mengarah tepat ke domain utama Anda.</span>
                </div>
              </div>
              <div class="flex gap-3">
                <span class="w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">✓</span>
                <div>
                  <span class="font-bold text-white block">Optimasi Tag Alt Gambar</span>
                  <span class="text-xs text-neutral-500 block">Setiap visual di halaman wajib memiliki deskripsi alt-text yang mengandung kata kunci seperti "rumah murah bandar" atau "KPR subsidi batang".</span>
                </div>
              </div>
            </div>

            <div class="space-y-4">
              <div class="flex gap-3">
                <span class="w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">✓</span>
                <div>
                  <span class="font-bold text-white block">Pemeriksaan Tag Heading (H1, H2, H3)</span>
                  <span class="text-xs text-neutral-500 block">Setiap halaman hanya diperbolehkan memiliki tepat satu H1 sebagai judul inti kaya kata kunci lokasi, diikuti H2 dan H3 secara terstruktur.</span>
                </div>
              </div>
              <div class="flex gap-3">
                <span class="w-6 h-6 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">✓</span>
                <div>
                  <span class="font-bold text-white block">Skema Markup JSON-LD Valid</span>
                  <span class="text-xs text-neutral-500 block">Uji cuplikan schema buatan kita menggunakan Google Rich Results Test guna memverifikasi tidak adanya kesalahan kurung kurawal.</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- 2. ARTICLES MANAGER PANEL -->
      <div id="panel-articles" class="tab-panel hidden space-y-8">
        <div class="flex justify-between items-center border-b border-neutral-800 pb-4">
          <div>
            <h2 class="font-outfit font-black text-xl text-white">Artikel & Konten Manager</h2>
            <p class="text-xs text-neutral-400">Pilih salah satu artikel aktif untuk memuatnya ke editor visual dan mengaudit nilai SEO-nya.</p>
          </div>
          <button id="btn-create-new-article" class="bg-brand-emerald-800 hover:bg-brand-emerald-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl uppercase tracking-wider transition">
            + Buat Artikel Baru
          </button>
        </div>

        <div id="articles-list-container" class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Articles list will be dynamically rendered here via script -->
        </div>
      </div>

      <!-- 3. SEO GRADER PANEL (Editor & Grader combined) -->
      <div id="panel-seo" class="tab-panel hidden space-y-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Left Column: Inputs -->
          <div class="lg:col-span-7 bg-neutral-900 border border-neutral-800 rounded-3xl p-6 sm:p-8 space-y-6">
            <div class="flex justify-between items-center border-b border-neutral-800 pb-3">
              <h2 class="font-outfit font-black text-xl text-white">Visual Post Editor & SEO Grader</h2>
              <span id="editor-editing-badge" class="bg-brand-emerald-800/20 text-brand-emerald-400 border border-brand-emerald-800/30 text-[9px] font-black px-3 py-1 rounded-full uppercase tracking-wider">
                Mode: Membuat Baru
              </span>
            </div>
            
            <div class="space-y-4 text-sm">
              <div class="space-y-1">
                <label for="seo-input-keyword" class="text-xs font-bold text-neutral-400 uppercase tracking-wider block">Kata Kunci Sasaran (Target Keyword) *</label>
                <input 
                  type="text" 
                  id="seo-input-keyword" 
                  placeholder="Misal: perumahan bandar batang" 
                  value="perumahan bandar batang"
                  class="w-full px-4 py-3 rounded-xl bg-neutral-950 border border-neutral-800 text-white focus:outline-none focus:border-brand-emerald-600 transition"
                />
              </div>

              <div class="space-y-1">
                <div class="flex justify-between items-center">
                  <label for="seo-input-title" class="text-xs font-bold text-neutral-400 uppercase tracking-wider block">Judul Halaman / SEO Title Tag *</label>
                  <span id="char-count-title" class="text-[10px] text-neutral-500 font-bold">0 Karakter</span>
                </div>
                <input 
                  type="text" 
                  id="seo-input-title" 
                  placeholder="Ketik judul SEO yang menarik..." 
                  class="w-full px-4 py-3 rounded-xl bg-neutral-950 border border-neutral-800 text-white focus:outline-none focus:border-brand-emerald-600 transition text-sm font-semibold"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="space-y-1">
                  <label for="seo-input-category" class="text-xs font-bold text-neutral-400 block">Kategori Silo *</label>
                  <select 
                    id="seo-input-category" 
                    class="w-full px-4 py-3 rounded-xl bg-neutral-950 border border-neutral-800 text-white focus:outline-none focus:border-brand-emerald-600 transition bg-neutral-950"
                  >
                    <option value="kpr">KPR & Keuangan (kpr)</option>
                    <option value="properti">Kabar Properti (properti)</option>
                    <option value="investasi">Investasi & Area (investasi)</option>
                  </select>
                </div>
                <div class="space-y-1">
                  <label for="seo-input-author" class="text-xs font-bold text-neutral-400 block">Penulis Konten</label>
                  <input 
                    type="text" 
                    id="seo-input-author" 
                    value="Tim Sales Endah Residence II"
                    class="w-full px-4 py-3 rounded-xl bg-neutral-950 border border-neutral-800 text-white focus:outline-none focus:border-brand-emerald-600 transition"
                  />
                </div>
                <div class="space-y-1">
                  <label for="seo-input-date" class="text-xs font-bold text-neutral-400 block">Tanggal Publikasi</label>
                  <input 
                    type="date" 
                    id="seo-input-date" 
                    class="w-full px-4 py-3 rounded-xl bg-neutral-950 border border-neutral-800 text-white focus:outline-none focus:border-brand-emerald-600 transition bg-neutral-950"
                  />
                </div>
              </div>

              <div class="space-y-1">
                <div class="flex justify-between items-center">
                  <label for="seo-input-desc" class="text-xs font-bold text-neutral-400 uppercase tracking-wider block">Meta Description / Rangkuman Halaman *</label>
                  <span id="char-count-desc" class="text-[10px] text-neutral-500 font-bold">0 Karakter</span>
                </div>
                <textarea 
                  id="seo-input-desc" 
                  rows="2"
                  placeholder="Tulis ringkasan halaman yang menarik untuk memicu klik..." 
                  class="w-full px-4 py-3 rounded-xl bg-neutral-950 border border-neutral-800 text-white focus:outline-none focus:border-brand-emerald-600 transition text-xs sm:text-sm leading-relaxed"
                ></textarea>
              </div>

              <div class="space-y-1">
                <div class="flex justify-between items-center">
                  <label for="seo-input-body" class="text-xs font-bold text-neutral-400 uppercase tracking-wider block">Isi Artikel / Konten (Mendukung Markdown) *</label>
                  <span id="word-count-body" class="text-[10px] text-neutral-500 font-bold">0 Kata</span>
                </div>
                <textarea 
                  id="seo-input-body" 
                  rows="8"
                  placeholder="Ketik atau tempel isi tulisan Anda di sini..." 
                  class="w-full px-4 py-3 rounded-xl bg-neutral-950 border border-neutral-800 text-white focus:outline-none focus:border-brand-emerald-600 transition text-xs sm:text-sm leading-relaxed"
                ></textarea>
              </div>

              <!-- FAQ Section Builder -->
              <div class="space-y-3 pt-2">
                <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider block">Tambahkan Q&A FAQ (Picu Google Rich Snippets)</span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <input type="text" id="builder-faq-q" placeholder="Pertanyaan..." class="w-full px-4 py-2 rounded-xl bg-neutral-950 border border-neutral-800 text-white focus:outline-none focus:border-brand-emerald-600 text-xs" />
                  <input type="text" id="builder-faq-a" placeholder="Jawaban..." class="w-full px-4 py-2 rounded-xl bg-neutral-950 border border-neutral-800 text-white focus:outline-none focus:border-brand-emerald-600 text-xs" />
                </div>
                <button type="button" id="btn-builder-add-faq" class="w-full bg-brand-emerald-900/50 hover:bg-brand-emerald-800 text-emerald-300 font-bold px-4 py-2 rounded-xl text-xs transition border border-brand-emerald-800/30">
                  + Tambahkan FAQ ke Artikel
                </button>
                <div id="builder-faq-container" class="space-y-2 text-xs">
                  <!-- Dynamic FAQ Lists -->
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Live Grades & Preview & Compiled Code -->
          <div class="lg:col-span-5 space-y-6">
            
            <!-- Dynamic Grading Gauge -->
            <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-6 text-center space-y-4">
              <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider block">Hasil Skor Audit SEO</span>
              <div class="relative w-28 h-28 mx-auto flex items-center justify-center">
                <div class="absolute inset-0 rounded-full border-8 border-neutral-800"></div>
                <div id="seo-score-glow" class="absolute inset-1 rounded-full border-8 border-brand-emerald-600 shadow-lg shadow-brand-emerald-500/20 transition-all duration-300"></div>
                <span id="seo-score-text" class="font-outfit font-black text-4xl text-white relative z-10">0</span>
              </div>
              <span id="seo-score-grade" class="font-outfit font-bold text-sm text-brand-emerald-500 block uppercase">SEO Sangat Optimal</span>
            </div>

            <!-- Google Search SERP Simulator -->
            <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-5 space-y-4">
              <div class="flex justify-between items-center border-b border-neutral-800 pb-2">
                <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider block">Google SERP Simulator</span>
                <div class="flex bg-neutral-950 border border-neutral-800 p-0.5 rounded-lg text-[9px] font-bold uppercase">
                  <button id="btn-serp-mobile" class="px-2 py-0.5 rounded bg-brand-emerald-800 text-white">Mobile</button>
                  <button id="btn-serp-desktop" class="px-2 py-0.5 rounded text-neutral-500 hover:text-white">Desktop</button>
                </div>
              </div>
              <div id="serp-preview-box" class="bg-white text-neutral-900 p-4 rounded-xl border border-neutral-200/80 space-y-1 font-sans text-left max-w-sm sm:max-w-md mx-auto transition-all duration-300">
                <div class="flex items-center gap-2 text-xs text-neutral-500">
                  <div class="w-6 h-6 rounded-full bg-neutral-100 flex items-center justify-center shrink-0">
                    <span class="font-extrabold text-[10px] text-brand-emerald-800">ER</span>
                  </div>
                  <div class="flex flex-col leading-none">
                    <span class="text-neutral-800 font-semibold text-[11px] block">Endah Residence II</span>
                    <span id="serp-preview-url" class="text-[10px] text-neutral-500 block">https://endahresidence.com > blog > kpr</span>
                  </div>
                </div>
                <h3 id="serp-preview-title" class="text-[#1a0dab] hover:underline cursor-pointer font-medium text-base leading-snug truncate">Judul Halaman</h3>
                <p id="serp-preview-desc" class="text-[#4d5156] text-[11px] leading-relaxed line-clamp-2">Deskripsi meta.</p>
              </div>
            </div>

            <!-- Exported Markdown Code Block -->
            <div class="bg-neutral-900 border border-neutral-800 rounded-3xl p-5 space-y-4">
              <div class="flex justify-between items-center border-b border-neutral-800 pb-2">
                <span class="text-xs font-bold text-neutral-400 uppercase tracking-wider block">Hasil Kode File Markdown (.md)</span>
                <button id="btn-copy-code" class="bg-neutral-950 hover:bg-neutral-800 border border-neutral-800 text-neutral-300 px-3 py-1 rounded-lg text-[9px] font-bold uppercase transition">
                  Copy Code
                </button>
              </div>
              <pre class="bg-neutral-950 border border-neutral-800 p-4 rounded-xl text-[10px] font-mono text-neutral-400 overflow-x-auto select-all max-h-[300px] leading-normal whitespace-pre-wrap"><code id="code-output-box"></code></pre>
            </div>

          </div>

        </div>

      </div>

      <!-- 4. THEME DESIGNER PANEL -->
      <div id="panel-theme" class="tab-panel hidden space-y-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          
          <!-- Controls Panel Left -->
          <div class="lg:col-span-6 bg-neutral-900 border border-neutral-800 rounded-3xl p-6 sm:p-8 space-y-6">
            <div>
              <h2 class="font-outfit font-black text-xl text-white">Desainer Warna & Background</h2>
              <p class="text-xs text-neutral-400 mt-1">Ubah palet warna website utama secara visual dan pratinjau hasilnya secara real-time.</p>
            </div>

            <div class="space-y-6 text-sm">
              
              <!-- Brand Primary Emerald Picker -->
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <label class="font-bold text-neutral-300 block">1. Warna Utama Brand (Primary color)</label>
                  <span id="hex-label-primary" class="text-xs font-mono font-bold text-neutral-500">#064e3b</span>
                </div>
                <div class="flex gap-4 items-center">
                  <input type="color" id="theme-color-primary" value="#064e3b" class="w-14 h-14 rounded-xl border border-neutral-800 cursor-pointer bg-transparent" />
                  <div class="text-xs text-neutral-500">
                    Merepresentasikan kredibilitas, alam, dan kestabilan. Digunakan pada navbar, tombol utama, dan heading utama.
                  </div>
                </div>
              </div>

              <!-- Brand Accent Amber Picker -->
              <div class="space-y-2">
                <div class="flex justify-between items-center">
                  <label class="font-bold text-neutral-300 block">2. Warna Aksen Aksi (Accent color)</label>
                  <span id="hex-label-accent" class="text-xs font-mono font-bold text-neutral-500">#d97706</span>
                </div>
                <div class="flex gap-4 items-center">
                  <input type="color" id="theme-color-accent" value="#d97706" class="w-14 h-14 rounded-xl border border-neutral-800 cursor-pointer bg-transparent" />
                  <div class="text-xs text-neutral-500">
                    Berfungsi untuk menarik mata ke area konversi utama. Digunakan untuk lencana promo, tombol WhatsApp, dan sorotan harga.
                  </div>
                </div>
              </div>

              <!-- Body Background Picker -->
              <div class="space-y-2">
                <div class="flex justify-between items-center">
