---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Import local fallback image if needed
import heroImage from '../../assets/images/hero_estate.png';
import tipe30Image from '../../assets/images/tipe_30_facade.png';
import tipe36Image from '../../assets/images/tipe_36_facade.png';
import progressRoad from '../../assets/images/progress_road.png';

// Fetch all posts from the 'blog' collection
const allPosts = await getCollection('blog');

// Sort posts by publishDate descending (newest first)
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Helper function to map cover image strings to actual imports or absolute paths
const getImageSource = (imageStr: string | undefined) => {
  if (imageStr?.includes('tipe_30_facade')) return tipe30Image;
  if (imageStr?.includes('tipe_36_facade')) return tipe36Image;
  if (imageStr?.includes('progress_road')) return progressRoad;
  return heroImage;
};

// Helper function to format category slugs to readable indonesian labels
const getCategoryLabel = (category: 'kpr' | 'properti' | 'investasi') => {
  const mapping = {
    kpr: 'KPR & Keuangan',
    properti: 'Kabar Properti',
    investasi: 'Investasi & Area'
  };
  return mapping[category];
};

const getCategoryColor = (category: 'kpr' | 'properti' | 'investasi') => {
  const mapping = {
    kpr: 'bg-emerald-100 text-emerald-800 border-emerald-200',
    properti: 'bg-amber-100 text-amber-800 border-amber-200',
    investasi: 'bg-blue-100 text-blue-800 border-blue-200'
  };
  return mapping[category];
};

const title = "Pusat Edukasi KPR & Info Properti Batang | Endah Residence II";
const description = "Temukan artikel edukasi cara pengajuan KPR rumah subsidi, tips membeli rumah pertama untuk pemula, dan tren investasi properti di Bandar Batang.";
---

<Layout title={title} description={description}>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-brand-emerald-50/50 to-white pt-16 pb-12 border-b border-neutral-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 bg-brand-emerald-100 text-brand-emerald-800 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
        Pusat Edukasi Properti
      </div>
      <h1 class="font-outfit font-black text-3xl sm:text-4xl lg:text-5xl text-neutral-900 leading-tight">
        Blog & Panduan Pembeli Rumah
      </h1>
      <p class="text-neutral-500 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Edukasi jujur dan transparan untuk membantu Anda memahami KPR, menguji legalitas developer, dan mengalkulasi potensi investasi di Bandar Batang.
      </p>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        
        {sortedPosts.map((post) => {
          const coverImage = getImageSource(post.data.image);
          const categoryLabel = getCategoryLabel(post.data.category);
          const categoryColor = getCategoryColor(post.data.category);
          const formattedDate = new Date(post.data.publishDate).toLocaleDateString('id-ID', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });
          
          return (
            <article class="bg-white rounded-3xl overflow-hidden shadow border border-neutral-100 hover:shadow-xl hover:-translate-y-1 transition duration-300 flex flex-col justify-between">
              
              <!-- Card Cover Photo -->
              <a href={`/blog/${post.data.category}/${post.id}`} class="block relative aspect-[16/10] overflow-hidden bg-neutral-100">
                <Image 
                  src={coverImage} 
                  alt={post.data.title}
                  class="w-full h-full object-cover hover:scale-105 transition duration-500"
                  sizes="(max-width: 640px) 100vw, 360px"
                  loading="lazy"
                />
                <div class="absolute top-4 left-4">
                  <span class={`text-[9px] font-extrabold px-3 py-1 rounded-full uppercase tracking-wider border shadow-sm ${categoryColor}`}>
                    {categoryLabel}
                  </span>
                </div>
              </a>

              <!-- Card Body Info -->
              <div class="p-6 flex-grow flex flex-col justify-between space-y-6">
                <div class="space-y-3">
                  <span class="text-[10px] text-neutral-400 font-bold block">{formattedDate} • Oleh {post.data.author}</span>
                  
                  <h2 class="font-outfit font-extrabold text-xl text-neutral-900 leading-snug hover:text-brand-emerald-700 transition">
                    <a href={`/blog/${post.data.category}/${post.id}`}>
                      {post.data.title}
                    </a>
                  </h2>
                  
                  <p class="text-neutral-500 text-xs sm:text-sm line-clamp-3 leading-relaxed">
                    {post.data.description}
                  </p>
                </div>

                <div class="border-t border-neutral-100 pt-4">
                  <a 
                    href={`/blog/${post.data.category}/${post.id}`}
                    class="inline-flex items-center text-xs font-bold text-brand-emerald-800 hover:text-brand-emerald-600 transition"
                  >
                    Baca Selengkapnya
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>

            </article>
          );
        })}

      </div>
      
    </div>
  </section>
</Layout>
