---
import Layout from '../layouts/Layout.astro';

const title = "Hubungi Marketing & Kontak Kami | Endah Residence 2 Batang";
const description = "Hubungi kantor pemasaran Endah Residence 2 Batang Bandar Batang. Dapatkan konsultasi KPR gratis, rute jalan Google Maps, dan jadwal survey lokasi.";
---

<Layout title={title} description={description}>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-brand-emerald-50/50 to-white pt-16 pb-12 border-b border-neutral-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 bg-brand-emerald-100 text-brand-emerald-800 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
        Hubungi Kami
      </div>
      <h1 class="font-outfit font-black text-3xl sm:text-4xl lg:text-5xl text-neutral-900 leading-tight">
        Hubungi & Kontak Marketing Kami
      </h1>
      <p class="text-neutral-500 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Apakah Anda memiliki pertanyaan mengenai program cicilan KPR flat, promo DP bulan ini, atau ingin menjadwalkan survey lokasi? Tim sales kami siap melayani Anda.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start max-w-5xl mx-auto">
        
        <!-- Left Column: NAP & Business Info -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="space-y-2">
            <span class="text-xs font-bold text-brand-amber-600 tracking-widest uppercase block">Informasi Kontak</span>
            <h2 class="font-outfit font-extrabold text-2xl text-neutral-900">Kantor Pemasaran Resmi</h2>
          </div>

          <!-- NAP consistency block -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-neutral-200/50 shadow-sm space-y-6">
            
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-emerald-100 text-brand-emerald-800 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="space-y-1">
                <span class="font-outfit font-bold text-neutral-800 text-sm sm:text-base block">Alamat Kantor & Proyek</span>
                <span class="text-xs sm:text-sm text-neutral-500 leading-relaxed block">
                  <strong>Endah Residence 2 Batang</strong><br />
                  Jl. Sendang-Tulis, Batiombo, Bandar, Batang, Jawa Tengah, 51254
                </span>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-emerald-100 text-brand-emerald-800 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.94.725l.548 2.2a1 1 0 01-.321.988l-1.305.98a10.582 10.582 0 004.872 4.872l.98-1.305a1 1 0 01.988-.321l2.2.548a1 1 0 01.725.94V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="space-y-1">
                <span class="font-outfit font-bold text-neutral-800 text-sm sm:text-base block">Telepon / WhatsApp</span>
                <span class="text-xs sm:text-sm text-neutral-500 block">
                  <a href="tel:087880211288" class="hover:text-neutral-900 transition font-semibold">0878-8021-1288</a> (Utama)<br />
                  <a href="tel:082134994060" class="hover:text-neutral-900 transition">0821-3499-4060</a>
                </span>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-brand-emerald-100 text-brand-emerald-800 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5a2 2 0 10-2 2h2zm0 0h4l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              </div>
              <div class="space-y-1">
                <span class="font-outfit font-bold text-neutral-800 text-sm sm:text-base block">Jam Operasional Kantor</span>
                <span class="text-xs sm:text-sm text-neutral-500 block">
                  Setiap Hari: 08.00 - 17.00 WIB<br />
                  <span class="text-brand-emerald-700 font-semibold text-xs">*Survey hari libur mohon janji temu dahulu</span>
                </span>
              </div>
            </div>

          </div>

          <!-- Google Maps Shortcut Button -->
          <a 
            href="https://maps.google.com/?q=Batiombo+Bandar+Batang+Endah+Residence" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="w-full inline-flex items-center justify-center bg-neutral-900 hover:bg-neutral-800 text-white font-outfit font-bold py-3.5 rounded-2xl transition hover:scale-[1.01]"
          >
            Petunjuk Arah Google Maps
          </a>

        </div>

        <!-- Right Column: Lead Form (with Anti-Spam Honeypot) -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 border border-neutral-200/50 shadow-sm space-y-6">
          <div class="space-y-1">
            <h2 class="font-outfit font-extrabold text-2xl text-neutral-900">Kirim Pesan Penawaran</h2>
            <p class="text-neutral-500 text-xs sm:text-sm">
              Tinggalkan data kontak Anda di bawah ini. Tim perwakilan marketing kami akan menghubungi Anda dalam waktu maksimal 1x24 jam kerja.
            </p>
          </div>

          <form action="/kontak-success" method="POST" class="space-y-4 pt-2">
            <!-- Anti-Spam Honeypot Field (Hidden from real users, caught by bots) -->
            <div class="hidden">
              <label for="fax_number">Fax Number</label>
              <input type="text" id="fax_number" name="fax_number" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label for="fullname" class="text-xs font-bold text-neutral-700">Nama Lengkap *</label>
                <input 
                  type="text" 
                  id="fullname" 
                  name="fullname" 
                  required 
                  placeholder="Misal: Budi Santoso" 
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-brand-emerald-500 focus:border-transparent text-sm"
                />
              </div>
              <div class="space-y-1">
                <label for="whatsapp" class="text-xs font-bold text-neutral-700">Nomor WhatsApp *</label>
                <input 
                  type="tel" 
                  id="whatsapp" 
                  name="whatsapp" 
                  required 
                  placeholder="Contoh: 081234567890" 
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-brand-emerald-500 focus:border-transparent text-sm"
                />
              </div>
            </div>

            <div class="space-y-1">
              <label for="unittarget" class="text-xs font-bold text-neutral-700">Tipe Rumah yang Diminati *</label>
              <select 
                id="unittarget" 
                name="unittarget" 
                required 
                class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-brand-emerald-500 focus:border-transparent text-sm bg-white"
              >
                <option value="" disabled selected>Pilih Tipe Rumah...</option>
                <option value="tipe-32">Tipe 32/66 (Subsidi)</option>
                <option value="tipe-48">Tipe 48/66 (Subsidi Plus)</option>
                <option value="belum-pasti">Belum Pasti (Ingin Konsultasi Dahulu)</option>
              </select>
            </div>

            <div class="space-y-1">
              <label for="message" class="text-xs font-bold text-neutral-700">Pesan / Pertanyaan Anda</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                placeholder="Tuliskan pertanyaan Anda mengenai simulasi cicilan, survey lokasi, atau promo..." 
                class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:ring-2 focus:ring-brand-emerald-500 focus:border-transparent text-sm"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full inline-flex items-center justify-center bg-brand-emerald-800 hover:bg-brand-emerald-700 text-white font-outfit font-bold py-3.5 rounded-2xl transition duration-300 shadow-xl shadow-brand-emerald-800/10 hover:scale-[1.01] text-base"
            >
              Kirim Formulir Kontak
            </button>
          </form>
        </div>

      </div>
    </div>
  </section>
</Layout>
